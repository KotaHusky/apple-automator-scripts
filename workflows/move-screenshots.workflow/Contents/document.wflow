				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>set -euo pipefail

DEST="$HOME/Screenshots"
mkdir -p "$DEST"

setopt nullglob
files=("$HOME/Desktop/Screenshot"*)

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

mv -n "${files[@]}" "$DEST/"</string>
